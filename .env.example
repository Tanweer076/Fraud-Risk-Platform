# Copy to .env (git-ignored) and adjust. Paths are relative to the repository root.
DATABASE_URL=postgresql+psycopg://fraud:fraud@localhost:5432/fraud
# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
MODEL_DIR=ml/artifacts
RULES_PATH=data/raw/OneRecon_DataSet/business_rules.txt
UPLOAD_DIR=data/uploads
CORS_ORIGINS=http://localhost:5173
# Hosts the MA REST API may be pulled from, comma-separated. Empty disables pulling by URL.
MA_API_ALLOWED_HOSTS=
LOG_LEVEL=INFO
