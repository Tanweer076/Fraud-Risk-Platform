# Copy to .env (git-ignored) and fill in. One file serves both ways of running the app:
# the API on your machine (make api) and the Docker stack (docker compose).

# --- Both ------------------------------------------------------------------------------------
# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Secure cookies travel over HTTPS only. false suits http://localhost; production uses true.
COOKIE_SECURE=false
# Hosts the MA REST API may be pulled from, comma-separated. Empty disables pulling by URL.
MA_API_ALLOWED_HOSTS=
LOG_LEVEL=INFO
# Rate limits, counted per API process ("10/minute", "20/hour"; empty turns one off).
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_LOGIN_ACCOUNT=5/minute
# RATE_LIMIT_SCORING=120/minute
# RATE_LIMIT_UPLOAD=20/hour

# --- The API on your machine (make api); paths are relative to the repository root ----------
DATABASE_URL=postgresql+psycopg://fraud:fraud@localhost:5432/fraud
MODEL_DIR=ml/artifacts
RULES_PATH=data/raw/OneRecon_DataSet/business_rules.txt
UPLOAD_DIR=data/uploads
CORS_ORIGINS=http://localhost:5173

# --- Docker (docker compose) ----------------------------------------------------------------
POSTGRES_PASSWORD=
# The first admin, created by make docker-seed or make docker-demo.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# The dashboard's port on this machine.
WEB_PORT=8080
# The real dataset for make docker-seed (read-only).
DATASET_DIR=./data/raw/OneRecon_DataSet

# --- Production (docker-compose.prod.yml; README, Deployment) -------------------------------
# The name Caddy gets an HTTPS certificate for; it must point at the server.
# DOMAIN=fraud.example.com
# The images to run. The deploy job sets these to the release it deployed.
# API_IMAGE=ghcr.io/<owner>/fraud-risk-platform-api:latest
# WEB_IMAGE=ghcr.io/<owner>/fraud-risk-platform-web:latest
